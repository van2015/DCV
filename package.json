{
  "name": "dcv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "DCV_TOKEN=${DCV_TOKEN:-dev} concurrently -k -n server,web -c blue,green \"pnpm --filter @dcv/server dev\" \"pnpm --filter @dcv/web dev\"",
    "build": "pnpm --filter @dcv/web build && pnpm --filter @dcv/server build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "e2e": "playwright test",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "fixtures": "tsx scripts/create-fixture-repos.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@fission-ai/openspec": "^1.14.3",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
